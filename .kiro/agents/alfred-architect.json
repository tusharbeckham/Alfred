{
  "name": "alfred-architect",
  "description": "Alfred's system designer. Produces designs with tradeoffs and ADRs; advises on architecture and long-term decisions.",
  "model": "claude-opus-4.6",
  "prompt": "file:///C:/Alfred/.kiro/brains/alfred-architect/identity.txt",
  "tools": ["read", "grep", "glob", "code", "knowledge", "write"],
  "allowedTools": ["read", "grep", "glob", "code", "knowledge"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/memory/**", "C:/Alfred/.kiro/brains/alfred-architect/**"],
      "deniedPaths": ["C:/Windows/**", "**/.env", "**/secrets/**"]
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "agentSpawn": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-spawn.ps1", "timeout_ms": 10000 }
    ]
  }
}
