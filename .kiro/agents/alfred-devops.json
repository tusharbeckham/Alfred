{
  "name": "alfred-devops",
  "description": "Alfred's CI/CD and git engineer. Runs the CI gate, manages branches/worktrees/PRs, prepares (never auto-runs) deploys.",
  "model": "claude-opus-4.6",
  "prompt": "file:///C:/Alfred/.kiro/brains/alfred-devops/identity.txt",
  "tools": ["read", "write", "shell", "grep", "glob", "knowledge"],
  "allowedTools": ["read", "grep", "glob", "knowledge"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/**"],
      "deniedPaths": ["C:/Windows/**", "**/.env", "**/secrets/**", "**/*.key", "**/*.pem", "C:/Alfred/.kiro/agents/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "allowedCommands": ["git\\s+(status|add|commit|switch|checkout|branch|log|diff|fetch|pull|merge|worktree|stash|restore)", "npm\\s+(ci|install|run|test)", "pytest", "python\\s+-m\\s+pytest", "cargo\\s+(build|test|clippy|check)", "go\\s+(build|test|vet)", "dotnet\\s+(build|test)", "make", "gradle", "mvn"],
      "deniedCommands": ["rm\\s+-rf", "format\\s", "reg\\s+(add|delete)", "Remove-Item.*-Recurse", "git\\s+push.*(main|master)", "git\\s+push\\s+--force", "git\\s+reset\\s+--hard", "git\\s+clean\\s+-", "shutdown", "Stop-Computer"]
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "postToolUse": [
      { "matcher": "shell", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/post-shell.ps1", "timeout_ms": 10000 }
    ],
    "stop": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-stop.ps1", "timeout_ms": 15000 }
    ]
  }
}
