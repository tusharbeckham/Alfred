{
  "mcpServers": { "alfred": { "command": "node", "args": ["C:\\Alfred\\mcp\\alfred-server.js"], "timeout": 30000 } },
  "name": "alfred",
  "description": "Alfred — the supreme overseer. Sits ABOVE alfred-manager and alfred-leader: the Owner's top-level AI that directs and audits the entire agent team, delegates production coordination to alfred-manager, and routes routine coding to the free local model. Ultrathink.",
  "model": "claude-opus-4.8",
  "prompt": "file:///C:/Alfred/.kiro/brains/alfred/identity.txt",
  "tools": ["read", "write", "shell", "grep", "glob", "subagent", "knowledge", "todo_list"],
  "allowedTools": ["read", "grep", "glob", "knowledge", "todo_list", "@alfred/read_memory", "@alfred/list_agents", "@alfred/query_eval_results"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/**"],
      "deniedPaths": ["C:/Windows/**", "**/.env", "**/secrets/**", "**/*.key", "**/*.pem", "C:/Alfred/.kiro/agents/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": ["rm\\s+-rf", "del\\s+/[sqf]", "format\\s", "reg\\s+(add|delete)", "Remove-Item.*-Recurse", "git\\s+push.*(origin\\s+)?(main|master)", "git\\s+push\\s+--force", "git\\s+reset\\s+--hard", "git\\s+clean\\s+-", "shutdown", "Stop-Computer"]
    },
    "subagent": {
      "availableAgents": ["alfred-*"],
      "trustedAgents": ["alfred-manager", "alfred-leader", "alfred-reviewer", "alfred-researcher", "alfred-planner", "alfred-evaluator", "alfred-math", "alfred-physics"]
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "agentSpawn": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-spawn.ps1", "timeout_ms": 10000 }
    ],
    "stop": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-stop.ps1", "timeout_ms": 15000 }
    ]
  },
  "keyboardShortcut": "ctrl+shift+o",
  "welcomeMessage": "Alfred here, sir — overseeing the whole team. What shall we accomplish?"
}
