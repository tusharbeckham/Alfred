{
  "mcpServers": { "alfred": { "command": "node", "args": ["C:\\Alfred\\mcp\\alfred-server.js"], "timeout": 30000 } },
  "name": "alfred",
  "description": "Alfred — the supreme overseer and TRUE ORCHESTRATOR. Sits ABOVE alfred-manager and alfred-leader: the Owner's top-level AI that directs and audits the entire agent team, delegates freely to every agent with no permission friction, manages the token/credit budget, and degrades gracefully to local models instead of crashing. Ultrathink.",
  "model": "claude-opus-4.8",
  "prompt": "file:///C:/Alfred/.kiro/brains/alfred/identity.txt",
  "tools": ["read", "write", "shell", "grep", "glob", "code", "subagent", "knowledge", "todo_list"],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "knowledge",
    "todo_list",
    "subagent",
    "write",
    "@alfred/read_memory",
    "@alfred/list_agents",
    "@alfred/query_eval_results"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/**", "C:/projects/**"],
      "deniedPaths": [
        "C:/Windows/**",
        "C:/Program Files/**",
        "C:/Program Files (x86)/**",
        "**/.env",
        "**/.env.*",
        "**/secrets/**",
        "**/*.key",
        "**/*.pem",
        "**/*.pfx",
        "**/id_rsa*",
        "C:/Alfred/.kiro/settings/**",
        "C:/Alfred/policy/harness-policy.json",
        "C:/Alfred/policy/harness-policy.sig"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "rm\\s+-rf",
        "del\\s+/[sqf]",
        "format\\s",
        "diskpart",
        "bcdedit",
        "vssadmin",
        "cipher\\s+/w",
        "reg\\s+(add|delete)",
        "Remove-Item.*-Recurse",
        "Set-ItemProperty.*HKLM",
        "New-Service",
        "Set-Service",
        "Stop-Service",
        "Set-ExecutionPolicy",
        "schtasks\\s+/(create|delete|change)",
        "Register-ScheduledTask",
        "netsh\\s+(advfirewall|firewall)",
        "New-NetFirewallRule",
        "Set-NetFirewallProfile",
        "net\\s+(user|localgroup)",
        "Add-LocalGroupMember",
        "git\\s+push.*(origin\\s+)?(main|master)",
        "git\\s+push\\s+--force",
        "git\\s+push\\s+-f",
        "git\\s+reset\\s+--hard",
        "git\\s+clean\\s+-",
        "git\\s+branch\\s+-D",
        "shutdown",
        "Stop-Computer",
        "Restart-Computer",
        "Invoke-Expression",
        "iex\\s",
        "curl.*\\|\\s*(bash|sh|powershell)"
      ]
    },
    "subagent": {
      "availableAgents": ["alfred-*", "local-coder"],
      "trustedAgents": [
        "alfred-manager",
        "alfred-leader",
        "alfred-architect",
        "alfred-planner",
        "alfred-prompt-engineer",
        "alfred-coder",
        "alfred-tester",
        "alfred-reviewer",
        "alfred-researcher",
        "alfred-debugger",
        "alfred-devops",
        "alfred-pc-ops",
        "alfred-security",
        "alfred-docs",
        "alfred-data",
        "alfred-math",
        "alfred-physics",
        "alfred-backend",
        "alfred-ml",
        "alfred-business",
        "alfred-finance",
        "alfred-cloud",
        "alfred-sre",
        "alfred-frontend",
        "alfred-release",
        "alfred-perf",
        "alfred-data-engineer",
        "alfred-qa",
        "alfred-integrations",
        "alfred-product",
        "alfred-data-scientist",
        "alfred-evaluator",
        "alfred-trainer",
        "alfred-memory-curator",
        "alfred-agent-builder",
        "local-coder"
      ]
    }
  },
  "resources": [
    "file:///C:/Alfred/.kiro/brains/alfred/brain.md",
    "file:///C:/Alfred/.kiro/brains/alfred/skills.md",
    "file:///C:/Alfred/.kiro/brains/alfred/reflexes.md",
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "agentSpawn": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-spawn.ps1", "timeout_ms": 10000 }
    ],
    "preToolUse": [
      { "matcher": "write", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/pre-write.ps1", "timeout_ms": 10000 }
    ],
    "postToolUse": [
      { "matcher": "shell", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/post-shell.ps1", "timeout_ms": 10000 }
    ],
    "stop": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-stop.ps1", "timeout_ms": 15000 }
    ]
  },
  "keyboardShortcut": "ctrl+shift+o",
  "welcomeMessage": "Alfred here, sir — orchestrating the whole team. What shall we accomplish?"
}
