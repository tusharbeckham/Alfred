{
  "name": "alfred-evaluator",
  "description": "Alfred's eval runner. Runs eval datasets against prompts/agents, scores with rubrics, records results. Does not edit prompts.",
  "model": "claude-opus-4.6",
  "prompt": "file:///C:/Alfred/.kiro/brains/alfred-evaluator/identity.txt",
  "tools": ["read", "write", "shell", "grep", "glob", "code", "knowledge"],
  "allowedTools": ["read", "grep", "glob", "code", "knowledge"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/evals/results/**", "C:/Alfred/memory/**"],
      "deniedPaths": ["C:/Windows/**", "**/.env", "**/secrets/**", "C:/Alfred/prompts/**", "C:/Alfred/.kiro/agents/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": ["rm\\s+-rf", "format\\s", "reg\\s+(add|delete)", "Remove-Item.*-Recurse", "git\\s+push.*(main|master)", "shutdown", "Stop-Computer"]
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "stop": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-stop.ps1", "timeout_ms": 15000 }
    ]
  }
}
