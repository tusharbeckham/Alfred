{
  "name": "local-coder",
  "description": "Alfred's LOCAL, subscription-free coder. Handles routine/low-stakes tasks (boilerplate, single-file fixes, quick lookups, small scripts, PC-Ops helper code) by calling the local model (Granite 4.1 8B) via LM Studio at http://localhost:1234 through scripts/local-coder.ps1 — NOT Opus 4.8. Reserve complex/architectural work for the Opus agents.",
  "model": "claude-sonnet-4.6",
  "prompt": "file:///C:/Alfred/.kiro/brains/local-coder/identity.txt",
  "tools": ["read", "write", "shell", "grep", "glob", "knowledge"],
  "allowedTools": ["read", "grep", "glob", "knowledge"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["C:/Alfred/**"],
      "deniedPaths": ["C:/Windows/**", "**/.env", "**/secrets/**", "**/*.key", "**/*.pem", "C:/Alfred/.kiro/agents/**", "C:/Alfred/.kiro/steering/**", "C:/Alfred/hooks/**", "C:/Alfred/.kiro/settings/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "allowedCommands": ["powershell.*local-coder\\.ps1", "ollama\\s+(list|show|ps|run)"],
      "deniedCommands": ["rm\\s+-rf", "del\\s+/[sqf]", "format\\s", "reg\\s+(add|delete)", "Remove-Item.*-Recurse", "git\\s+push.*(main|master)", "git\\s+push\\s+--force", "git\\s+reset\\s+--hard", "git\\s+clean\\s+-", "shutdown", "Stop-Computer", "ollama\\s+(rm|pull|create|cp)"]
    }
  },
  "resources": [
    {
      "type": "knowledgeBase",
      "source": "file:///C:/Alfred/memory",
      "name": "alfred-shared-memory",
      "indexType": "best",
      "include": ["**/*.md"],
      "autoUpdate": true
    }
  ],
  "hooks": {
    "preToolUse": [
      { "matcher": "write", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/pre-write.ps1", "timeout_ms": 10000 }
    ],
    "postToolUse": [
      { "matcher": "shell", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/post-shell.ps1", "timeout_ms": 10000 }
    ],
    "stop": [
      { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/on-stop.ps1", "timeout_ms": 15000 }
    ]
  }
}
