# Copy to `.env` (or set as Space/host secrets). NEVER commit real keys — .env is gitignored.

# --- LOCAL: our Alfred-Coder via LM Studio — free, offline, great for testing (NOT for public) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=alfred-coder-7b

# --- PUBLIC: powerful, low-latency hosted options. Pick ONE, set your key, verify the model id ---
# Groq (very fast — recommended for "no lag"):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_your_key
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Fireworks:
#   LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#   LLM_API_KEY=fw_your_key
#   LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
#
# Together:
#   LLM_BASE_URL=https://api.together.xyz/v1
#   LLM_API_KEY=your_together_key
#   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# (Model ids drift — confirm the current name in the provider's model list.)

# --- Guard tuning ---
RATE_PER_MIN=20
RATE_BURST=5
MAX_LEN=2000
MAX_CONCURRENCY=32
PORT=7860
