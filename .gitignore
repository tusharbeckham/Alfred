# Alfred — never commit logs, transient run output, caches, generated data, or secrets.

# transient run logs / captures (hook + eval/train logs)
memory/session-log.txt
memory/shell-log.txt
training/_*.log
evals/results/_*.log

# local databases (e.g., sqlite MCP)
memory/*.db

# generated fine-tune data (regenerable from data/finetune/examples.md)
data/finetune/train.jsonl
data/finetune/val.jsonl

# secrets — NEVER commit
.env
.env.*
*.key
*.pem
*.pfx
**/secrets/**
*secret*.txt
*token*.txt

# OS / editor cruft
Thumbs.db
.DS_Store
.vscode/

# hardened secret ignores
**/mail.json
**/telegram.json

# personal / local-only — kept on disk, never published to GitHub
/memory/
/data/finetune/
/evals/results/
*.gguf


# Personal — the Owner's Alfred description (portfolio use, not for the repo)
docs/about-alfred.md


# Piper TTS binary + voice models (large; re-fetch with scripts/setup-piper.ps1)
tools/piper/


# Engage drafts (personal, ephemeral review docs - not for the repo)
memory/engage-drafts/


# Public-deploy local secrets / config (never commit real keys)
deploy/.env
deploy/blocklist.txt


# Python cache
__pycache__/
*.pyc

# Keep the key-free deploy env TEMPLATE tracked (the real .env stays ignored above)
!deploy/.env.example


# Local HF Space upload staging (copies of deploy files; not source of truth)
deploy/hf-space/


# Cloudflare Wrangler local state (build/deploy cache; can hold OAuth tokens - never commit)
.wrangler/
deploy/cloudflare/.wrangler/
